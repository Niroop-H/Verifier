library (mqv_tiny) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1,pf);
  nom_process : 1;
  nom_temperature : 25;
  nom_voltage : 1.0;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;

  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.10");
    index_2 ("0.01, 0.10");
  }

  cell (INV_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.01;
    }
    pin (Y) {
      direction : output;
      function : "!A";
      max_capacitance : 10.0;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_template) { values ("0.05, 0.06", "0.07, 0.08"); }
        cell_fall (delay_template) { values ("0.05, 0.06", "0.07, 0.08"); }
        rise_transition (delay_template) { values ("0.01, 0.02", "0.02, 0.03"); }
        fall_transition (delay_template) { values ("0.01, 0.02", "0.02, 0.03"); }
      }
    }
  }
}
